# Authentication (GitHub OAuth App)
GITHUB_ID=your-github-oauth-client-id
GITHUB_SECRET=your-github-oauth-client-secret
# Generate secret with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# Database
# Example: PostgreSQL database URL from Supabase, Neon, Railway, or local Docker
DATABASE_URL="postgresql://user:password@localhost:5432/learncraft?schema=public"

# Optional Developer Tools (Disabled by default in production)
ENABLE_DEV_IMPROVE=false
